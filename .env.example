# Copy to .env.local and fill in. Never commit .env.local.
# Find these in Supabase Dashboard -> Project Settings -> API Keys.

# --- Public (browser) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Newer projects: the publishable key (sb_publishable_...). Preferred.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon JWT key. Used only if the publishable key is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-side scripts only (npm run seed:users). NEVER expose to the browser,
# --- never prefix with NEXT_PUBLIC_, and do not set it on Vercel.
# Legacy service_role JWT, or the newer secret key (sb_secret_...) in SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Demo users created by npm run seed:users (min 8 characters) -------------
SEED_ADVISER_PASSWORD=
SEED_OWNER_PASSWORD=
